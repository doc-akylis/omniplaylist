# ==========================================
# OmniPlaylist 2.0 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha apenas o necessário
# ==========================================

# Ambiente da Aplicação
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Banco de Dados SQLite & Diretório de Downloads
DATABASE_URL=sqlite:///./omniplaylist.db
DOWNLOAD_DIR=./downloads

# Spotify API (Opcional — apenas para sincronização de playlists)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback/spotify

# YouTube Music (Opcional — caminho para arquivo OAuth/cookies)
YTMUSIC_AUTH_FILE=./ytmusic_auth.json

# Amazon Music (Opcional — caminho para cookies de sessão Playwright)
AMAZON_MUSIC_COOKIES_FILE=./amazon_cookies.json

# Enriquecimento de Metadados & Descoberta (Todos opcionais — degradam graciosamente)
ACOUSTID_API_KEY=
LISTENBRAINZ_TOKEN=
LASTFM_API_KEY=
DISCOGS_TOKEN=

# Provedores Multi-Source de Aquisição Autorizada & Comercial B2B (v2.2 — opcionais)
JAMENDO_CLIENT_ID=
SOUNDCLOUD_CLIENT_ID=
FREESOUND_API_KEY=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
SEVENDIGITAL_API_KEY=
SEVENDIGITAL_API_SECRET=
RIGHTS_FOUNDRY_API_KEY=
QOBUZ_APP_ID=
QOBUZ_USER_TOKEN=
